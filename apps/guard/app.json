{
  "expo": {
    "name": "Loc8 Guard",
    "slug": "loc8-guard",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "../../assets/images/icon.png",
    "scheme": "loc8guard",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Loc8 Guard shows your team where you are on the live map and where to respond — even with no signal. Shared only with your team.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Loc8 Guard keeps you on the team map and can broadcast an SOS with your position while on shift, even in the background.",
        "NSBluetoothAlwaysUsageDescription": "Loc8 Guard uses Bluetooth to keep your team connected phone-to-phone when the network is jammed or dead.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "bluetooth-central",
          "bluetooth-peripheral"
        ]
      },
      "bundleIdentifier": "com.emotiveimpact.loc8guard"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "BLUETOOTH_SCAN",
        "BLUETOOTH_ADVERTISE",
        "BLUETOOTH_CONNECT",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_CONNECTED_DEVICE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.emotiveimpact.loc8guard"
    },
    "web": {
      "output": "static",
      "favicon": "../../assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Loc8 Guard keeps you on the team map and can broadcast SOS while on shift, shared only with your team."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#06070d",
          "image": "../../assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b700136e-a472-4e0d-8448-c9569e1a3e18"
      }
    },
    "owner": "emotiveimpact"
  }
}
