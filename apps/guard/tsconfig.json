{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["node"],
    "paths": {
      "@loc8/engine": ["../../packages/engine/src/index.ts"],
      "@loc8/engine/*": ["../../packages/engine/src/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["app/**/*.ts", "app/**/*.tsx", "src/**/*.ts", "src/**/*.tsx", "expo-env.d.ts"],
  "exclude": ["src/**/__tests__/**"]
}
