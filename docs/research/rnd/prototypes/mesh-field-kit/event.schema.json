{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loc8.local/schemas/loc8.mesh-field-evidence.v1.json",
  "title": "Loc8 MESH-01 field evidence event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "runId",
    "cohortId",
    "blockId",
    "deviceRole",
    "eventIndex",
    "monotonicNs",
    "wallTimeMs",
    "action",
    "frameId",
    "sequence",
    "originRole",
    "ttlBefore",
    "ttlAfter",
    "linkHandle",
    "reason",
    "payloadBytes",
    "wireBytes"
  ],
  "properties": {
    "schema": { "const": "loc8.mesh-field-evidence.v1" },
    "runId": { "type": "string", "minLength": 8, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "cohortId": { "type": "string", "minLength": 1, "maxLength": 48, "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "blockId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "deviceRole": { "enum": ["A", "B", "C"] },
    "eventIndex": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "monotonicNs": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,19})$" },
    "wallTimeMs": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "action": {
      "enum": [
        "diagnostics-started",
        "link-up",
        "link-down",
        "origin",
        "ingress",
        "duplicate-drop",
        "stale-drop",
        "future-drop",
        "malformed-drop",
        "relay-scheduled",
        "relay-cancelled",
        "relay-forwarded",
        "application-delivery",
        "egress-skipped",
        "diagnostics-stopped"
      ]
    },
    "frameId": {
      "oneOf": [
        { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$" },
        { "type": "null" }
      ]
    },
    "sequence": { "type": ["integer", "null"], "minimum": 0, "maximum": 99 },
    "originRole": { "enum": ["A", "B", "C", null] },
    "ttlBefore": { "type": ["integer", "null"], "minimum": 0, "maximum": 7 },
    "ttlAfter": { "type": ["integer", "null"], "minimum": 0, "maximum": 7 },
    "linkHandle": {
      "oneOf": [
        { "type": "string", "minLength": 16, "maxLength": 16, "pattern": "^[a-f0-9]{16}$" },
        { "type": "null" }
      ]
    },
    "reason": {
      "enum": [
        "duplicate",
        "stale",
        "future",
        "malformed",
        "mtu-too-small",
        "write-backpressure-overflow",
        "notify-backpressure-overflow",
        "scheduled-relay-cancelled",
        "diagnostic-overflow",
        null
      ]
    },
    "payloadBytes": { "enum": [25, null] },
    "wireBytes": { "enum": [47, null] }
  }
}
