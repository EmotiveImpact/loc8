{
  "name": "loc8",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "dependencies": {
    "@loc8/engine": "*",
    "@expo-google-fonts/sora": "^0.4.2",
    "@expo-google-fonts/space-mono": "^0.4.2",
    "@expo-google-fonts/unbounded": "^0.4.1",
    "@expo/ui": "~57.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.2",
    "expo-battery": "~57.0.0",
    "expo-blur": "~57.0.0",
    "expo-camera": "~57.0.1",
    "expo-clipboard": "~57.0.0",
    "expo-constants": "~57.0.3",
    "expo-device": "~57.0.0",
    "expo-font": "~57.0.0",
    "expo-glass-effect": "~57.0.0",
    "expo-haptics": "~57.0.0",
    "expo-image": "~57.0.0",
    "expo-image-picker": "~57.0.2",
    "expo-linear-gradient": "~57.0.0",
    "expo-linking": "~57.0.1",
    "expo-location": "~57.0.2",
    "expo-notifications": "~57.0.3",
    "expo-router": "~57.0.3",
    "expo-splash-screen": "~57.0.2",
    "expo-status-bar": "~57.0.0",
    "expo-symbols": "~57.0.0",
    "expo-system-ui": "~57.0.0",
    "expo-web-browser": "~57.0.0",
    "lucide-react-native": "^1.23.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/node_modules/",
      "<rootDir>/.claude/",
      "<rootDir>/GUARDBACKUP/",
      "<rootDir>/docs/research/rnd/repos/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.claude/",
      "<rootDir>/GUARDBACKUP/",
      "<rootDir>/docs/research/rnd/repos/"
    ],
    "moduleNameMapper": {
      "^@loc8/engine$": "<rootDir>/packages/engine/src/index.ts",
      "^@loc8/engine/(.*)$": "<rootDir>/packages/engine/src/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|expo-modules-core|react-navigation|@react-navigation/.*|react-native-svg|react-native-reanimated|react-native-worklets|zustand)"
    ]
  },
  "private": true
}
